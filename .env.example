# Copy this file to .env.local and fill in the values from your Supabase project
# (Dashboard -> Project Settings -> API). .env.local is git-ignored (*.local).
#
# NEVER commit real values. NEVER put the service_role key here or anywhere in the frontend.
# Only the public "anon" key is safe to use in browser code, and only because
# Row Level Security is enabled (see supabase/schema.sql).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
